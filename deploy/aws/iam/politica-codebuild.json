{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloneCompletoDoGitHub",
      "Effect": "Allow",
      "Action": ["codeconnections:UseConnection", "codestar-connections:UseConnection"],
      "Resource": "<ARN-DA-CONEXAO-COM-O-GITHUB>"
    },
    {
      "Sid": "LoginNoEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushSoNoRepositorioDaApi",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": "arn:aws:ecr:us-east-1:<CONTA>:repository/ovitrampas-api"
    }
  ]
}
